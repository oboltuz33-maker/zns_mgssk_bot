# Разработка (npm run dev) — работает с тестовым скриптом, чтобы правки при разработке не попадали в рабочую таблицу.
# Данные загружаются только в Telegram: вне его нет подписанных данных пользователя (initData), и приложение
# показывает «Откройте приложение из Telegram». Чтобы проверить dev-сервер с данными, откройте его адрес
# (например, через туннель) из тестового бота — подпись проверяется токеном того бота, чей скрипт указан ниже.
# Веб-приложение Apps Script тестовой таблицы (адрес развёртывания, не секрет)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx3AoCWxK8sLnjmuQobiqTrKWZREaJ9XzU28YnWs7j4fWTdcMkhxWxo-5-upOJECT4lOg/exec
# Путь приложения на GitHub Pages
VITE_BASE=/zns_mgssk_bot/
# Метка окружения в приложении
VITE_ENV_LABEL=DEV
