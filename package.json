{
  "name": "zns-mgssk-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://oboltuz33-maker.github.io/zns_mgssk_bot/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "predeploy": "npm run lint && npm test && npm run build",
    "deploy": "gh-pages -d dist --remove \"assets/**\"",
