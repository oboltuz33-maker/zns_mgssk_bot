    "deploy:test": "gh-pages -d dist-test --dest test"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "gh-pages": "^6.1.1",
    "oxlint": "^1.91.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
